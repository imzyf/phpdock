###########################################################
##  OVERRIDES ONLY - NOT THE FULL VARIABLE LIST
##
##  This file lists ONLY the values that differ from the
##  upstream defaults. Everything else falls back to:
##
##    .env.upstream              (upstream .env.example)
##    <service>/defaults.env     (per-service defaults)
##
##  Look there first for a variable you cannot find here.
###########################################################

###########################################################
###################### General Setup ######################
###########################################################

### Paths #################################################

# Choose storage path on your machine. For all storage systems
DATA_PATH_HOST=~/.phpdock/data

### Drivers ###############################################

# All volumes driver
VOLUMES_DRIVER=local

# All Networks driver
NETWORKS_DRIVER=bridge

### Docker compose files ##################################

# Define the prefix of container names.
COMPOSE_PROJECT_NAME=phpdock

### PHP Version ###########################################

# Select a PHP version of the Workspace and PHP-FPM containers.
PHP_VERSION=8.5

### Remote Interpreter ####################################

# Choose a Remote Interpreter entry matching name. Default is `laradock`
PHP_IDE_CONFIG=serverName=phpdock

###########################################################
################ Containers Customization #################
###########################################################

### POSTGRES ##############################################
POSTGRES_VERSION=18
